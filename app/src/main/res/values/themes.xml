<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.InstaBlock" parent="android:Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/text</item>
        <item name="android:colorAccent">@color/text</item>
        <item name="android:colorControlActivated">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <item name="android:alertDialogTheme">@style/Theme.InstaBlock.Dialog</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
    </style>

    <style name="Theme.InstaBlock.Dialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">@color/text</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:windowBackground">@drawable/bg_dialog</item>
    </style>

    <!-- Small uppercase label above a section. -->
    <style name="SectionLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Borderless text action. -->
    <style name="TextAction">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:background">?android:attr/selectableItemBackground</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="IconAction">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="android:tint">@color/text</item>
    </style>
</resources>
